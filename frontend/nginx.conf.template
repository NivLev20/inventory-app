# nginx serves the dashboard files and forwards /api/* to the Flask backend.
# ${BACKEND_URL} is filled in when the container starts (default: http://backend:5000).
server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    # index.html is always re-checked, so a new deployment shows up on the next page load
    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # Vite puts a content hash in asset file names, so they can be cached for a year
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }

    # Health check for Docker / Kubernetes
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }
}
