# ${BACKEND_URL} and ${NGINX_RESOLVER} are substituted at container start (see start.sh).
server {
    listen 8080;
    server_name _;

    # Resolve the backend name per request instead of once at startup, so nginx starts
    # even when cluster DNS is not ready yet. The resolver does not apply DNS search
    # domains, which is why Kubernetes passes the full service name in BACKEND_URL.
    resolver ${NGINX_RESOLVER} valid=10s ipv6=off;

    root /usr/share/nginx/html;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    # index.html is always re-checked, so a new deployment shows up on the next page load
    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # Vite puts a content hash in asset file names, so they can be cached for a year
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location /api/ {
        set $backend_upstream ${BACKEND_URL};
        proxy_pass $backend_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }
}
